PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=shortify
PGUSER=shortify_user
PGPASSWORD=change_me

BASE_URL=http://localhost:3000

JWT_SECRET=change_me_to_a_random_string

# Set to "true" to skip writing to the clicks table on every redirect —
# used for the Stage 4 load-test comparison (with vs. without click
# tracking). Leave unset/false for normal operation.
DISABLE_CLICK_TRACKING=false

REDIS_HOST=localhost
REDIS_PORT=6379

# Set to "true" to bypass all rate limiting — used for the Stage 7
# capacity load test, where every virtual user shares one IP and would
# otherwise all collapse onto the same rate-limit counter. Leave
# unset/false for normal operation.
DISABLE_RATE_LIMIT=false
